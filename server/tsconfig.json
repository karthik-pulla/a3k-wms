{
  // Source is plain TypeScript that Node can also run directly (tests run with node --test, no build):
  // only erasable syntax, and relative imports name the .ts file (rewritten to .js in dist/).
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"],
  // Runs the app's sync engine (app/src/sync/), which the app's own type-check covers
  "exclude": ["test/sync-engine.test.ts"]
}
