{
  "name": "wms-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A3K Imports warehouse management system (web app)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_WMS_DEMO=1 VITE_TENANT=demo vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dev:preview": "VITE_WMS_BACKEND=preview PORT=5175 vite",
    "build:server": "tsc -b && VITE_WMS_BACKEND=server vite build"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "4.10.38",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
